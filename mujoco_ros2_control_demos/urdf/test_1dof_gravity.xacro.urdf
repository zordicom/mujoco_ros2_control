<?xml version="1.0"?>
<!--
  1-DOF vertical pendulum for testing gravity compensation.

  This is a VERTICAL joint (unlike test_1dof_multimode which is horizontal).
  The pendulum hangs down, requiring gravity compensation to hold position.
-->
<robot name="test_1dof_gravity">
  <link name="world"/>

  <!-- Pendulum link: 1 kg mass at 0.5m from pivot -->
  <link name="pendulum">
    <inertial>
      <origin xyz="0.0 0.0 -0.5" rpy="0 0 0"/>  <!-- COM at 0.5m below pivot -->
      <mass value="1.0"/>
      <inertia ixx="0.0833" ixy="0.0" ixz="0.0"
               iyy="0.0833" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 -0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.5"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>

  <!-- Vertical revolute joint (rotates about Y-axis) -->
  <joint name="j1" type="revolute">
    <axis xyz="0 1 0"/>  <!-- Y-axis rotation -->
    <origin xyz="0 0 1" rpy="0 0 0"/>  <!-- Pivot at 1m height -->
    <parent link="world"/>
    <child link="pendulum"/>
    <limit lower="-1.57" upper="1.57" effort="30.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystem</plugin>
      <param name="mujoco_model">mujoco_models/test_1dof_gravity.xml</param>
      <param name="mujoco_model_package">mujoco_ros2_control_demos</param>
      <param name="mujoco_viewer">true</param>
    </hardware>
    <joint name="j1">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>

      <!-- PID gains for MIT-style control -->
      <!-- For 1kg at 0.5m: max gravity torque = 1*9.81*0.5 = 4.9 Nm -->
      <!-- Use high Kp for stiff position control -->
      <!-- MIT mode gains (position_kp for Kp, velocity_kp for Kd) -->
      <param name="position_kp">100.0</param>
      <param name="velocity_kp">10.0</param>
      <!-- Simple kp/kd aliases for zordi_ros_controllers -->
      <param name="kp">100.0</param>
      <param name="kd">10.0</param>
    </joint>
  </ros2_control>
</robot>
