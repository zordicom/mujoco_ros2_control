<!--
Copyright 2025 Zordi, Inc. All rights reserved.

2-DOF Planar Robot Arm for Cartesian Controller Testing

This is a simple 2-link planar robot arm (horizontal, like a SCARA arm) for testing
the Zordi Cartesian controller. Both joints are revolute and move in the
horizontal plane (XY plane).

Link 1: 0.5m long, 1kg, extends in +X direction
Link 2: 0.5m long, 0.5kg, extends in +X direction
-->
<robot name="cartpole_2dof">
  <!-- Base link (fixed to world) -->
  <link name="world"/>
  
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Link 1 (extends horizontally in +X direction) -->
  <link name="link1">
    <visual>
      <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>  <!-- Rotated to point in +X -->
      <geometry>
        <cylinder radius="0.03" length="0.5"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.5"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.021" iyz="0" izz="0.021"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>  <!-- Rotates around Z axis (planar motion in XY plane) -->
    <limit lower="-3.14" upper="3.14" effort="50.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Link 2 (extends horizontally in +X direction from end of link1) -->
  <link name="link2">
    <visual>
      <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>  <!-- Rotated to point in +X -->
      <geometry>
        <cylinder radius="0.025" length="0.5"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.5"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.011" iyz="0" izz="0.011"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>  <!-- Attached at end of link1 in +X -->
    <axis xyz="0 0 1"/>  <!-- Rotates around Z axis (planar motion in XY plane) -->
    <limit lower="-3.14" upper="3.14" effort="25.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- End-effector link (for Cartesian control) -->
  <link name="ee_link">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.8 0.2 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="link2_to_ee" type="fixed">
    <parent link="link2"/>
    <child link="ee_link"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>  <!-- At end of link2 in +X -->
  </joint>

  <!-- ROS2 Control -->
  <ros2_control name="cartpole_2dof" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- PID gains for MuJoCo MIT mode -->
      <param name="position_kp">100.0</param>
      <param name="velocity_kp">10.0</param>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- PID gains for MuJoCo MIT mode -->
      <param name="position_kp">50.0</param>
      <param name="velocity_kp">5.0</param>
    </joint>
  </ros2_control>
</robot>

