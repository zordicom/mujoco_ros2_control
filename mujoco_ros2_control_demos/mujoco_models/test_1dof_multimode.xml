<mujoco model="test_1dof_multimode">
  <option timestep="0.001" integrator="RK4" solver="PGS"/>

  <worldbody>
    <geom type="plane" size="1 1 0.1" pos="0 0 -0.1"/>

    <body name="link" pos="0 0 0">
      <joint name="j1" type="hinge" axis="0 0 1" damping="5.0"/>
      <inertial pos="0 0 0.1" mass="2.0" diaginertia="0.05 0.05 0.01"/>
      <geom type="capsule" fromto="0 0 0  0 0 0.2" size="0.05"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Position actuator: validated kp=100, kv=0 -->
    <position name="act_pos_j1" joint="j1"
              kp="100.0" kv="0.0"
              ctrlrange="-1.57 1.57" forcerange="-20 20"/>

    <!-- Velocity actuator: validated kv=10 -->
    <velocity name="act_vel_j1" joint="j1"
              kv="10.0"
              ctrlrange="-2.0 2.0" forcerange="-20 20"/>

    <!-- Motor actuator: direct torque -->
    <motor name="act_tau_j1" joint="j1"
           ctrlrange="-20 20" forcerange="-20 20"/>
  </actuator>
</mujoco>
