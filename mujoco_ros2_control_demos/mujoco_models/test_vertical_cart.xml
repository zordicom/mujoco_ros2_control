<mujoco>
	<option gravity="0 0 -9.81">
		<flag contact="enable" />
	</option>
	<worldbody>
        <light diffuse=".5 .5 .5" pos="0 0 5" dir="0 0 -1" />
		<geom type="plane" size="20 20 0.1" rgba="1 1 1 1" />

        <body name="slideBar" pos="0 0 2.5" euler="0 0 0">
            <geom type="box" size="0.025 0.025 2.5" rgba="0 .8 0 1" />
            <inertial pos="0 0 0" mass="100" diaginertia="1.0 1.0 1.0" />
            <body name="cart" pos="0 0 0" euler="0 0 0">
                <joint name="slider_to_cart" type="slide" axis="0 0 1" pos="0 0 0" range="-2.5 2.5" />
                <geom type="box" size="0.25 0.25 0.1" rgba="0 0 .8 1" />
                <inertial pos="0 0 0" mass="1" diaginertia="1.0 1.0 1.0" />
            </body>
        </body>
	</worldbody>
    <actuator>
        <!-- Position actuator: kv=0.0 for MIT mode compatibility -->
        <position name="act_pos_slider_to_cart" joint="slider_to_cart"
                  kp="100.0" kv="0.0"
                  ctrlrange="-2 2" forcerange="-1000 1000"/>

        <!-- Velocity actuator -->
        <velocity name="act_vel_slider_to_cart" joint="slider_to_cart"
                  kv="10.0"
                  ctrlrange="-10 10" forcerange="-1000 1000"/>

        <!-- Torque actuator -->
        <motor name="act_tau_slider_to_cart" joint="slider_to_cart"
               ctrlrange="-1000 1000" forcerange="-1000 1000"/>
    </actuator>
    <contact>
        <exclude body1="slideBar" body2="cart" />
    </contact>
</mujoco>
