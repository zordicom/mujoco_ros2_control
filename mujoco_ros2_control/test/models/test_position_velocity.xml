<!-- MuJoCo model for Position+Velocity Servo Test -->
<!-- Demonstrates position+velocity control (like Dynamixel Profile Position mode) -->
<mujoco model="position_velocity_pendulum">
  <compiler angle="radian"/>

  <option gravity="0 0 -9.81" timestep="0.001"/>

  <worldbody>
    <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.9 0.9 0.9 1"/>

    <body name="base_link" pos="0 0 0.5">
      <geom type="box" size="0.05 0.05 0.05" rgba="0.5 0.5 0.5 1"/>

      <body name="pendulum" pos="0 0 0">
        <joint name="joint1" type="hinge" axis="0 1 0" range="-3.14 3.14" damping="0.1"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.5" size="0.02" rgba="0.8 0.6 0.2 1" mass="1.0"/>
      </body>
    </body>
  </worldbody>

  <!-- Position+Velocity mode: separate actuators for PD control -->
  <!-- Control law: τ = kp*(pos_cmd - q) + kv*(vel_cmd - qd) -->
  <actuator>
    <!-- Position actuator: kp=100, kv=0 (no velocity damping) -->
    <position name="act_pos_joint1" joint="joint1"
              kp="100.0" kv="0.0"
              ctrlrange="-3.14 3.14" forcerange="-50 50"/>

    <!-- Velocity actuator: kv=10 (provides the D term) -->
    <velocity name="act_vel_joint1" joint="joint1"
              kv="10.0"
              ctrlrange="-10.0 10.0" forcerange="-50 50"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0"/>
    <key name="tilted" qpos="0.5"/>
    <key name="horizontal" qpos="1.57"/>
  </keyframe>
</mujoco>
