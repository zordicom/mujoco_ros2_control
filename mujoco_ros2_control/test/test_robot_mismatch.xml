<mujoco model="test_robot">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <worldbody>
    <body name="base_link">
      <geom type="box" size="0.05 0.05 0.05" rgba="0.8 0.8 0.8 1"/>

      <body name="link1">
        <joint name="test_joint1" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
        <geom type="cylinder" size="0.02 0.05" pos="0 0 0.05" rgba="0.2 0.6 0.8 1"/>
        <inertial pos="0 0 0.05" mass="0.5" diaginertia="0.005 0.005 0.001"/>
      </body>
    </body>
  </worldbody>

  <!-- INTENTIONAL MISMATCH: Only define position and velocity actuators -->
  <!-- Missing the torque actuator (act_tau_test_joint1) -->
  <actuator>
    <position name="act_pos_test_joint1" joint="test_joint1"
              kp="20.0" kv="0.0"
              ctrlrange="-3.14 3.14" forcerange="-10 10"/>

    <velocity name="act_vel_test_joint1" joint="test_joint1"
              kv="2.0"
              ctrlrange="-2.0 2.0" forcerange="-10 10"/>

    <!-- MISSING: <motor name="act_tau_test_joint1" joint="test_joint1" ... /> -->
  </actuator>
</mujoco>
