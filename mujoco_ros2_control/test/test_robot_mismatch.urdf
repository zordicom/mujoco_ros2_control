<?xml version="1.0"?>
<robot name="test_robot">
  <!-- Minimal robot with single joint for testing interface validation -->

  <link name="world"/>

  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="link1">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.1"/>
      </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </visual>
  </link>

  <joint name="test_joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="2.0"/>
  </joint>

  <!-- ROS2 Control Interface -->
  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystem</plugin>
    </hardware>

    <joint name="test_joint1">
      <!-- Declare all three command interfaces -->
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>

      <!-- State interfaces -->
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>

      <!-- PID gains for MIT mode -->
      <param name="position_kp">20.0</param>
      <param name="position_ki">0.0</param>
      <param name="position_kd">0.0</param>

      <param name="velocity_kp">0.0</param>
      <param name="velocity_ki">0.0</param>
      <param name="velocity_kd">2.0</param>
    </joint>
  </ros2_control>
</robot>
